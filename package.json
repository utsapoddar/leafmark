{
  "name": "leafmark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "tsx --test tests/*.test.ts",
    "guide:run": "tsx scripts/run-guide.ts",
    "relay:dev": "npx wrangler@latest dev --config relay/wrangler.jsonc",
    "relay:dry-run": "npx wrangler@latest deploy --config relay/wrangler.jsonc --dry-run",
    "relay:deploy": "npx wrangler@latest deploy --config relay/wrangler.jsonc"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^16.3.3",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
